#!/bin/sh
set -eu
_d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "${WT_LIB:-$_d/../lib/wt/lib.sh}"

usage() {
  cat >&2 <<EOF
usage: wt [-d] [-p <file>] <command>
  list           TSV of every worktree: repo, path, branch, window_id
  open <path>    focus the window for <path>, creating it if needed
  close          kill the current window (worktree is left on disk)
  new <branch> [dir]
                 create a worktree at <repo>-worktrees/<branch> and open it.
                 [dir] selects the repo (default: \$PWD) -- a keybinding must
                 pass it, since run-shell does not inherit the pane's cwd
  menu           fzf popup over every worktree; Enter opens it
  live           fzf popup over every window running Claude; Enter jumps there
  adopt [path]   re-point THIS window at [path] (default: \$PWD), for when a
                 session moved into a worktree without changing windows

  -d             open/new: create the window in the background, print its id,
                 and work outside tmux too (for agents starting a worker)
  -p <file>      open/new: start Claude with <file>'s contents as the prompt

per-repo git config (e.g. via includeIf in ~/.gitconfig):
  wt.dir         worktree folder relative to the repo, instead of the sibling
                 <repo>-worktrees/
  wt.base        start point for a new branch (default: the repo's HEAD);
                 a remote ref is fetched first
  wt.claude      command started in the left pane (default: claude)
EOF
  exit 2
}

# wt_cfg <repo> <key> <default>
wt_cfg() {
  git -C "$1" config --get "wt.$2" 2>/dev/null || printf '%s' "$3"
}

# Command typed into the left pane. The prompt is read by the pane's own shell,
# so a multi-line brief needs no quoting here; only the path is quoted.
wt_claude_cmd() {
  cmd=$(wt_cfg "$1" claude claude)
  [ -n "$prompt" ] && cmd="$cmd \"\$(cat '$prompt')\""
  printf '%s' "$cmd"
}

require_tmux() {
  [ -n "${TMUX:-}" ] || { echo "wt: not inside tmux" >&2; exit 1; }
}

wt_open() {
  path=$1
  [ -n "$detach" ] || require_tmux
  [ -d "$path" ] || { echo "wt: no such worktree: $path" >&2; exit 1; }

  existing=$(wt_window_for_path "$path" || true)
  if [ -n "$existing" ]; then
    if [ -n "$detach" ]; then
      printf '%s\n' "$existing"
      return 0
    fi
    tmux select-window -t "$existing"
    tmux switch-client -t "$existing" 2>/dev/null || true
    return 0
  fi

  main=$(wt_main_for "$path") || { echo "wt: not a git worktree: $path" >&2; exit 1; }
  sess=$(wt_sanitize_session "$(basename "$main")")
  br=$(git -C "$path" branch --show-current 2>/dev/null || true)
  [ -n "$br" ] || br=$(git -C "$path" rev-parse --short HEAD 2>/dev/null || echo detached)
  win=$(wt_sanitize_window "$br")

  if tmux has-session -t "=$sess" 2>/dev/null; then
    wid=$(tmux new-window -t "=$sess:" -c "$path" -n "$win" -P -F '#{window_id}')
  else
    tmux new-session -d -s "$sess" -c "$path" -n "$win"
    wid=$(tmux list-windows -t "=$sess" -F '#{window_id}' | head -n1)
  fi

  tmux set -w -t "$wid" @wt_path "$path"
  p0=$(tmux list-panes -t "$wid" -F '#{pane_id}' | head -n1)
  tmux split-window -h -l 35% -t "$p0" -c "$path"
  # WT_SHELL=1: plain shell, no Claude -- for tests, and for agents whose
  # workers are subagents that only need the worktree path
  [ -n "${WT_SHELL:-}" ] || tmux send-keys -t "$p0" "$(wt_claude_cmd "$main")" Enter
  tmux select-pane -t "$p0"
  if [ -n "$detach" ]; then
    printf '%s\n' "$wid"
    return 0
  fi
  tmux select-window -t "$wid"
  tmux switch-client -t "$wid" 2>/dev/null || true
}

wt_close() {
  require_tmux
  sess=$(tmux display -p '#{session_name}')
  n=$(tmux list-windows -t "=$sess" | wc -l | tr -d ' ')
  if [ "$n" -le 1 ]; then
    tmux kill-session -t "=$sess"
  else
    tmux kill-window -t "$(tmux display -p '#{window_id}')"
  fi
}

# The context directory is an explicit argument because run-shell hands a
# command the INVOKER's cwd, not the pane's -- so from a keybinding $PWD is
# wherever the tmux client was attached from. Relying on it either failed
# outright (client attached outside a repo) or, worse, silently created the
# worktree in the wrong repo. The binding passes #{pane_current_path}.
wt_new() {
  branch=$1
  ctx=${2:-$PWD}
  [ -n "$detach" ] || require_tmux
  [ -d "$ctx" ] || { echo "wt: no such directory: $ctx" >&2; exit 1; }
  main=$(wt_main_for "$ctx") || { echo "wt: not in a git repo: $ctx" >&2; exit 1; }
  parent=$(dirname "$main")
  repo=$(basename "$main")
  wtdir=$(wt_cfg "$main" dir '')
  if [ -n "$wtdir" ]; then
    wtdir="$main/$wtdir"
  else
    wtdir="$parent/$repo-worktrees"
  fi
  dir="$wtdir/$(wt_sanitize_window "$branch")"

  if [ -d "$dir" ]; then
    wt_open "$dir"
    return 0
  fi

  mkdir -p "$wtdir"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add -q "$dir" "$branch"
  else
    base=$(wt_cfg "$main" base HEAD)
    # origin/HEAD and friends: fetch that remote so the branch starts from
    # what is on the server now, not whenever it was last fetched.
    remote=${base%%/*}
    if [ "$remote" != "$base" ] && git -C "$main" remote | grep -qx "$remote"; then
      git -C "$main" fetch -q "$remote"
    fi
    # --no-track: a branch off origin/<x> would otherwise track it, and a bare
    # `git push` would then aim at that branch.
    git -C "$main" worktree add -q --no-track -b "$branch" "$dir" "$base"
  fi
  wt_open "$dir"
}

# Human-readable picker rows. Field 1 stays the path so _pick can cut it back
# out; the rest is display only.
wt_rows() {
  # Same tab-IFS-squeeze bug as wt-poll and wt_list's internal parse (a tab
  # is POSIX "IFS whitespace" so consecutive delimiters collapse regardless
  # of what IFS is set to): translate wt_list's real-tab TSV to the unit
  # separator before reading. wt_list's PUBLIC output stays tab-separated;
  # only this parse changes.
  sep=$(printf '\037')
  wt_list | tr '\t' "$sep" | while IFS="$sep" read -r repo path branch wid; do
    mark=' '
    [ -n "$wid" ] && mark='*'
    printf '%s\t%s %-22s %s\n' "$path" "$mark" "$repo" "$branch"
  done
}

# One row per window with a Claude pane, in any session, wt-managed or not.
# Field 1 is the window id; the rest is display only. The process is
# "claude" on Linux and "claude.exe" on macOS. WT_CLAUDE_PROCS overrides the
# names for tests: macOS names a process after the real binary, so a stub
# called claude cannot be faked there.
wt_live_rows() {
  tmux list-panes -a -F "#{window_id}${WT_TAB}#{pane_current_command}${WT_TAB}#{session_name}${WT_TAB}#{window_name}${WT_TAB}#{pane_current_path}" 2>/dev/null |
    awk -F"$WT_TAB" -v home="$HOME" -v procs=" ${WT_CLAUDE_PROCS:-claude claude.exe} " '
      index(procs, " " $2 " ") && !seen[$1]++ {
        p = $5
        if (index(p, home) == 1) p = "~" substr(p, length(home) + 1)
        printf "%s\t%-28s %-22s %s\n", $1, $3, $4, p
      }'
}

# wt_pick [rows-function] [prompt]
wt_pick() {
  rows=${1:-wt_rows}
  # WT_PICK_CMD replaces the whole picker; tests set it to something
  # deterministic. Overriding just the binary would break, because the fzf
  # flags below are not portable to another command.
  if [ -n "${WT_PICK_CMD:-}" ]; then
    "$rows" | sh -c "$WT_PICK_CMD" | cut -f1
  else
    "$rows" | fzf --with-nth=2.. --delimiter="$WT_TAB" --no-sort --reverse \
      --prompt="${2:-worktree}> " 2>/dev/null | cut -f1
  fi
}

wt_menu() {
  require_tmux
  # $0 may be a bare name; the popup gets its own PATH, so resolve it here.
  self="$_d/wt"
  tmux display-popup -E -w 80% -h 60% \
    "sel=\$($self _pick); [ -n \"\$sel\" ] && $self open \"\$sel\""
}

wt_live() {
  require_tmux
  self="$_d/wt"
  tmux display-popup -E -w 80% -h 60% \
    "sel=\$($self _livepick); [ -n \"\$sel\" ] && tmux select-window -t \"\$sel\" && tmux switch-client -t \"\$sel\""
}

# Re-point the CURRENT window at a worktree, in place. This exists because a
# Claude session can move itself into a worktree mid-session (EnterWorktree)
# without the tmux window following: the pane's cwd is unchanged, so the window
# keeps tracking whatever `wt open` set. Adoption fixes the tracking without
# closing the session or opening a second window.
wt_adopt() {
  require_tmux
  target=${1:-$PWD}
  [ -d "$target" ] || { echo "wt: no such directory: $target" >&2; exit 1; }

  root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null) || {
    echo "wt: not inside a git worktree: $target" >&2
    exit 1
  }

  cur=$(tmux display -p '#{window_id}')
  other=$(wt_window_for_path "$root" || true)
  if [ -n "$other" ] && [ "$other" != "$cur" ]; then
    echo "wt: $root is already tracked by window $other" >&2
    exit 1
  fi

  tmux set -w -t "$cur" @wt_path "$root"
  br=$(git -C "$root" branch --show-current 2>/dev/null || true)
  [ -n "$br" ] || br=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo detached)
  tmux rename-window -t "$cur" "$(wt_sanitize_window "$br")"
  printf 'adopted %s\n' "$root"
}

detach=
prompt=
while [ $# -gt 0 ]; do
  case "$1" in
    -d) detach=1; shift ;;
    -p) [ $# -ge 2 ] || usage
        [ -f "$2" ] || { echo "wt: no such prompt file: $2" >&2; exit 1; }
        prompt=$(CDPATH= cd -- "$(dirname -- "$2")" && pwd)/$(basename -- "$2")
        shift 2 ;;
    *)  break ;;
  esac
done

cmd=${1:-}
[ -n "$cmd" ] || usage
shift || true

case "$cmd" in
  list)  wt_list ;;
  open)  [ $# -ge 1 ] || usage; wt_open "$1" ;;
  close) wt_close ;;
  new)   [ $# -ge 1 ] || usage; wt_new "$1" "${2:-$PWD}" ;;
  menu)  wt_menu ;;
  live)  wt_live ;;
  adopt) wt_adopt "${1:-$PWD}" ;;
  _rows) wt_rows ;;
  _pick) wt_pick ;;
  _live) wt_live_rows ;;
  _livepick) wt_pick wt_live_rows claude ;;
  _cmd)  [ $# -ge 1 ] || usage; wt_claude_cmd "$(wt_main_for "$1")" ;;
  *)     usage ;;
esac
